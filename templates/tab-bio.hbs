<div class="bio-tab">
  <div class="bio-section">
    <h3 class="section-title">Demographics</h3>
    <div class="demographics-grid">
      <div class="demo-item">
        <span class="demo-label">Race:</span>
        <span class="demo-value">{{bio.race}}</span>
      </div>
      <div class="demo-item">
        <span class="demo-label">Gender:</span>
        <span class="demo-value">{{bio.gender}}</span>
      </div>
      <div class="demo-item">
        <span class="demo-label">Alignment:</span>
        <span class="demo-value">{{bio.alignment}}</span>
      </div>
      <div class="demo-item">
        <span class="demo-label">Background:</span>
        <span class="demo-value">{{bio.background}}</span>
      </div>
      <div class="demo-item">
        <span class="demo-label">Exp:</span>
        <span class="demo-value">{{bio.xp}}</span>
      </div>
    </div>
  </div>

  <div class="bio-section">
    <h3 class="section-title">Backstory</h3>
    <textarea class="backstory-textarea" name="system.details.biography.value">{{bio.biography}}</textarea>
  </div>
</div>

